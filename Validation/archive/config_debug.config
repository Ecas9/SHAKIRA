// cheaha.config -- nf-core/rnavar on UAB Cheaha (Slurm + Singularity)
// Pass with: -c /ABSOLUTE/PATH/cheaha.config   (resources/infra only; tool params go in -params-file)
//
// Sizing anchored to Cheaha hardware doc + observed peak RSS from execution_trace.
//   per-NODE max: 48 cores / 754 GB ; per-USER QoS: 264 cores / 3072 GB (Slurm-enforced)

process.resourceLimits = [ cpus: 48, memory: 360.GB, time: 150.h ]

process {
    executor = 'slurm'
    queue    = 'short'

    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,151,247] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel:process_low    { cpus = 2;  memory = { 12.GB * task.attempt }; time = 6.h  }
    withLabel:process_medium { cpus = 8;  memory = { 42.GB * task.attempt }; time = 12.h }
    withLabel:process_high   { cpus = 16; memory = { 72.GB * task.attempt }; time = 12.h }

    withName:'.*FASTQC.*' { errorStrategy = 'ignore' }
    // QC-only stats (feed MultiQC, nothing downstream): never let them halt the run.
    // NB: scoped to FLAGSTAT/STATS/IDXSTATS only -- NOT SAMTOOLS_INDEX / SAMTOOLS_SORT,
    // whose outputs the variant calling depends on.
    withName:'.*SAMTOOLS_(FLAGSTAT|IDXSTATS|STATS).*' { errorStrategy = 'ignore' }

    withName:'.*STAR_ALIGN.*' {
        cpus   = 20
        memory = { 110.GB * task.attempt }
        time   = 12.h
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName:'.*STAR_GENOMEGENERATE.*' { cpus = 16; memory = { 72.GB * task.attempt }; time = 12.h }

    withName:'.*MARKDUPLICATES.*'   { cpus = 4; memory = { 40.GB * task.attempt }; time = 12.h }
    withName:'.*SPLITNCIGAR.*'      { cpus = 4; memory = { 22.GB * task.attempt }; time = 12.h }
    withName:'.*HAPLOTYPECALLER.*'  { cpus = 4; memory = { 16.GB * task.attempt }; time = 12.h }
    withName:'.*BASERECALIBRATOR.*' { cpus = 2; memory = { 20.GB * task.attempt }; time = 8.h  }
    withName:'.*APPLYBQSR.*'        { cpus = 2; memory = { 20.GB * task.attempt }; time = 8.h  }
}

executor {
    queueSize       = 30
    submitRateLimit = '15/1min'

    // Transient Slurm submission failures (sbatch "Batch job submission failed: ...")
    // bypass process.errorStrategy, so they must be retried here. The default reason only
    // matches "Socket timed out"; we broaden it so generic submission rejections also retry.
    retry {
        reason     = 'Socket timed out|Batch job submission failed'
        maxAttempt = 5
        delay      = '30s'
        maxDelay   = '5min'
        jitter     = 0.25
    }
}

singularity {
    enabled    = true
    autoMounts = true
}

trace {
    enabled   = true
    overwrite = true
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rss,vmem'
}
report   { enabled = true; overwrite = true }
timeline { enabled = true; overwrite = true }

workflow.onComplete = {
    println "Pipeline ${workflow.success ? 'COMPLETED' : 'FAILED'} | duration: ${workflow.duration}"
    if (!workflow.success) println "exit status: ${workflow.exitStatus} | check execution_trace_*.txt (status==FAILED) + .nextflow.log"
}